---
import '@sc/ui/tokens.css';
import '@sc/ui/app.css';
import '../styles/base.css';
import { MESSAGES, type Locale } from '@sc/i18n';
import { MODEL_CONFIG } from '../model-config.ts';

// Одной строкой: разбор фронтматтера Astro спотыкается на объединении типов
// с переносом и ведущей вертикальной чертой.
export type SectionId = 'home' | 'singularity' | 'catastrophe' | 'triggers' | 'countries' | 'compare' | 'model';

interface Props {
  locale: Locale;
  section: SectionId;
  title: string;
  description: string;
  heading: string;
  lede?: string | undefined;
}

const { locale, section, title, description, heading, lede } = Astro.props;
const t = MESSAGES[locale];
const other: Locale = locale === 'ru' ? 'en' : 'ru';

const SECTIONS: { id: SectionId; path: string }[] = [
  { id: 'home', path: '' },
  { id: 'singularity', path: 'singularity/' },
  { id: 'catastrophe', path: 'catastrophe/' },
  { id: 'triggers', path: 'triggers/' },
  { id: 'countries', path: 'countries/' },
  { id: 'compare', path: 'compare/' },
  { id: 'model', path: 'model/' },
];

const anchor = new Date(MODEL_CONFIG.anchor.at);
const path = SECTIONS.find((s) => s.id === section)!.path;

/**
 * Адреса в разметке для краулеров — абсолютные.
 *
 * Относительный og:image часть мессенджеров просто не разбирает, и
 * предпросмотр собирается без картинки. Поскольку картинка — заявленный
 * основной канал распространения, относительный адрес здесь равносилен
 * неработающей функции.
 *
 * Astro.site приходит из astro.config; на сборке Netlify это URL деплоя.
 */
const abs = (href: string) => new URL(href, Astro.site).href;

// Версия конфига в адресе картинки обязательна: без неё после правки констант
// в мессенджерах навсегда застынет старый предпросмотр.
const ogImage = abs(`/og?l=${locale}&v=${MODEL_CONFIG.version}`);
const canonical = abs(`/${locale}/${path}`);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.title} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={abs(`/${other}/${path}`)} />
    <link rel="alternate" hreflang="x-default" href={abs(`/ru/${path}`)} />
  </head>
  <body>
    <div class="wrap">
      <header>
        <p class="eyebrow">
          {t.eyebrow} · v{MODEL_CONFIG.version}
          {/* data-scenario обязателен и здесь: переключение языка — такой же
              переход между страницами, и без него сценарий молча сбрасывался. */}
          <a class="lang" href={`/${other}/${path}`} data-scenario>
            {other === 'ru' ? 'Русский' : 'English'}
          </a>
        </p>
        <h1>{heading}</h1>
        {lede ? <p class="lede" set:html={lede} /> : null}
      </header>

      <nav aria-label={t.navLabel} class="sections">
        <ul>
          {
            SECTIONS.map((item) => (
              <li>
                <a
                  href={`/${locale}/${item.path}`}
                  data-scenario
                  aria-current={item.id === section ? 'page' : undefined}
                >
                  {t.nav[item.id]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <footer>
        <p>
          {locale === 'ru' ? 'Опорная точка экстраполяции: 50%-горизонт' : 'Extrapolation anchor: a 50% horizon of'}
          <b>{MODEL_CONFIG.anchor.horizonMinutes}</b>
          {locale === 'ru' ? 'минут,' : 'minutes,'}
          {MODEL_CONFIG.anchor.model}, {anchor.getUTCFullYear()} (METR, TH1.1).
          {
            locale === 'ru'
              ? ' Коэффициенты сложности, лаги внедрения и веса ступеней — экспертное суждение, не измерение.'
              : ' Difficulty coefficients, deployment lags and rung weights are expert judgement, not measurement.'
          }
        </p>
        <div class="srcs">
          <a href="https://metr.org/blog/2026-1-29-time-horizon-1-1/">METR · Time Horizon 1.1</a>
          <a href="https://metr.org/time-horizons/">METR · Task-Completion Time Horizons</a>
          <a href="https://hai.stanford.edu/ai-index/2026-ai-index-report">Stanford HAI · AI Index 2026</a>
          <a href="https://incidentdatabase.ai/">AI Incident Database</a>
          <a href="https://www.tortoisemedia.com/data/global-ai">Tortoise · Global AI Index</a>
        </div>
        <p class="scenario-kept">{t.scenarioKept}</p>
      </footer>
    </div>
  </body>
</html>
