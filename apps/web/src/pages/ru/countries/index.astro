---
import Section from '../../../layouts/Section.astro';
import { Countries } from '../../../components/Countries.tsx';
import { MESSAGES } from '@sc/i18n';

const t = MESSAGES['ru'];
const now = Date.now();
---

<Section
  locale="ru"
  section="countries"
  title="Рейтинг стран и индекс гонки"
  description="Семь компонентов AI-лидерства с настраиваемыми весами и индекс гонки по Херфиндалю–Хиршману."
  heading={t.nav.countries}
>
  <Countries client:load locale="ru" now={now} />
</Section>
