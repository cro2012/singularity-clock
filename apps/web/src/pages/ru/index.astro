---
import Section from '../../layouts/Section.astro';
import { Home } from '../../components/Home.tsx';
import { MESSAGES } from '@sc/i18n';

const t = MESSAGES['ru'];
const now = Date.now();
---

<Section
  locale="ru"
  section="home"
  title="Часы Сингулярности — обратный отсчёт"
  description="Два обратных отсчёта из одной экстраполяции: до сингулярности и до катастрофы. Дата не результат — результат её чувствительность к допущениям."
  heading="Часы Сингулярности и Лестница Катастроф"
  lede={t.lede}
>
  <Home client:load locale="ru" now={now} />
</Section>
