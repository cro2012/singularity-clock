---
import Base from '../../layouts/Base.astro';
import { MODEL_CONFIG as config } from '../../model-config.ts';

// Конфиг читается на этапе сборки: если YAML не пройдёт схему, упадёт сборка,
// а не страница у пользователя.
const anchor = new Date(config.anchor.at);
---

<Base
  locale="ru"
  title="Часы Сингулярности — обратный отсчёт"
  description="Два обратных отсчёта из одной экстраполяции: до сингулярности и до катастрофы. Дата не результат — результат её чувствительность к допущениям."
>
  <header>
    <p class="eyebrow">Полушуточный прогнозный аппарат · v{config.version} · каркас</p>
    <h1>Часы Сингулярности и Лестница Катастроф</h1>
    <p class="lede">
      Каркас M0. Расчётное ядро появится в M1 — до тех пор здесь честно ничего не считается.
    </p>
  </header>

  <p class="anchor">
    Опорная точка модели: {config.anchor.model}, {anchor.getUTCFullYear()} — 50%-горизонт
    <b class="tabular">{config.anchor.horizonMinutes}</b> минут. Загружено из
    <code>model.v{config.version.split('.')[0]}.yaml</code>, {config.functions.length} видов
    деятельности и {config.industries.length} отраслей прошли валидацию.
  </p>
</Base>

<style>
  header {
    padding: 44px 0 26px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 26px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 10px;
  }
  h1 {
    font-size: 34px;
    line-height: 1.15;
    margin: 0 0 10px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .lede {
    color: var(--ink-2);
    max-width: 74ch;
    margin: 0;
  }
  .anchor {
    color: var(--ink-2);
    font-size: 13.5px;
    max-width: 80ch;
  }
  code {
    background: var(--surface-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--ink);
  }
</style>
