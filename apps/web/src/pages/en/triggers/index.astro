---
import Section from '../../../layouts/Section.astro';
import { Triggers } from '../../../components/Triggers.tsx';
import { MESSAGES } from '@sc/i18n';

const t = MESSAGES['en'];
const now = Date.now();
---

<Section
  locale="en"
  section="triggers"
  title="Trigger panel — what to watch"
  description="Observable events, each of which moves the model. Accelerating and calming."
  heading={t.nav.triggers}
>
  <Triggers client:load locale="en" now={now} />
</Section>
