---
import Section from '../../layouts/Section.astro';
import { Home } from '../../components/Home.tsx';
import { MESSAGES } from '@sc/i18n';

const t = MESSAGES['en'];
const now = Date.now();
---

<Section
  locale="en"
  section="home"
  title="The Singularity Clock — countdown"
  description="Two countdowns from a single extrapolation: to singularity and to catastrophe. The date is not the result — its sensitivity to assumptions is."
  heading="The Singularity Clock and the Ladder of Catastrophes"
  lede={t.lede}
>
  <Home client:load locale="en" now={now} />
</Section>
